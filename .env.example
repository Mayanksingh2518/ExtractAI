APP_NAME=Document Intelligence API
LOG_LEVEL=INFO

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192

DOWNLOAD_TIMEOUT_SECONDS=30
