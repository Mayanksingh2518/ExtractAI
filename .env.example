APP_NAME=Document Intelligence API
LOG_LEVEL=INFO

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192

DOWNLOAD_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BYTES=20971520
MAX_REDIRECTS=3
# Whole upload request (all files together); each file is also limited by MAX_DOWNLOAD_BYTES
MAX_UPLOAD_REQUEST_BYTES=104857600

PDF_RENDER_DPI=100
MAX_PDF_PAGES=10

# Documents processed at once (shared by all requests). Tune with scripts/benchmark_concurrency.py
MAX_CONCURRENT_DOCUMENTS=2
# Documents in the model at once. Match what Ollama really runs in parallel (qwen3-vl on Ollama 0.14: 1).
# Each document's classify + extract calls run back to back, so the extract call reuses the image work.
MODEL_PARALLEL_REQUESTS=1

# Optional API keys for POST /document-check, comma-separated, each 16+ characters
# (e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"). Empty = no authentication.
API_KEYS=
# Requests per client (API key, or IP when API_KEYS is empty) per window. 0 = no limit.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
